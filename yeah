services:
  redis:
    image: redis:alpine
    container_name: searxng-redis
    restart: unless-stopped
    volumes:
      - redis-data:/data
    networks:
      - searxng-internal

  searxng:
    image: searxng/searxng:latest
    container_name: searxng
    restart: unless-stopped
    volumes:
      - searxng-data:/etc/searxng
    environment:
      - SEARXNG_BASE_URL=http://search.app.mia.verycoolad/
      - SEARXNG_SECRET=${SEARXNG_SECRET}
      - SEARXNG_REDIS_URL=redis://redis:6379/0
    networks:
      - searxng-internal
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.searxng.rule=Host(`search.app.mia.verycoolad`)"
      - "traefik.http.routers.searxng.entrypoints=web"
      - "traefik.http.services.searxng.loadbalancer.server.port=8080"
      - "traefik.docker.network=proxy"
    depends_on:
      - redis

networks:
  searxng-internal:
  proxy:
    external: true

volumes:
  searxng-data:
  redis-data: